# Runtime
NODE_ENV=development
PORT=3002
CORS_ORIGIN=http://localhost:3000

# Database: omit DATABASE_URL to use the default SQLite file.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/bytechain_currencies
DATABASE_PATH=data/currencies.sqlite
# DB_SYNCHRONIZE=false
# DB_LOGGING=true
# DB_SSL=false

# Required for POST/PATCH/DELETE requests. Use a long random value.
ADMIN_API_KEY=replace-with-a-long-random-value

# Seed the bundled currencies on first start. Defaults to true in development.
SEED_ON_STARTUP=true
